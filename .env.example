# Copy this file to .env for local use. Keep credentials out of source control.
APP_ENV=development
SECRET_KEY=
DATABASE_URL=sqlite:///jagan_fertilizer.db

# Optional OpenAI-compatible provider. Leave blank to use the FAQ fallback.
CROP_ASSISTANT_API_KEY=
CROP_ASSISTANT_MODEL=
CROP_ASSISTANT_API_URL=https://api.openai.com/v1/chat/completions

# Optional trained classifier and matching metadata. No model ships with this project.
DISEASE_MODEL_PATH=models/plant_disease.keras
DISEASE_CONFIDENCE_THRESHOLD=0.65
